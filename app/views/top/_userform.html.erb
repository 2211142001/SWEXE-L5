<% signup = local_assigns.fetch(:signup, false) %>
<% if (@user && @user.errors.present?) || flash[:message].present? %>
  <h3>入力内容にエラーがあります</h3>
  <ul>
    <% if @user && @user.errors.present? %>
        <% @user.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
        <% end %>
    <% else %>
        <li><%= flash[:message] %></li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: @user, url: url do |f| %>
  <p>
    <%= f.label :uid, 'ユーザー' %>
    <%= f.text_field :uid %>
  </p>
  <p>
    <%= f.label :password, 'パスワード' %>
    <%= f.password_field :password %>
  </p>
  <% if signup %>
    <p>
      <%= f.label :password_confirmation, 'パスワード (確認)' %>
      <%= f.password_field :password_confirmation %>
    </p>
  <% end %>
  <%= f.submit signup ? '登録' : 'ログイン' %>
<% end %>