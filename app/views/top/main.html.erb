<style>
.main {
    .tweet {
        border: 1px solid #ccc;
        padding: 16px;
        margin-bottom: 10px;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .user {
        display: flex;
        gap: 8px;
        align-items: center;
        font-weight: bold;
    }

    .profile {
        font-weight: normal;
        font-size: 0.9em;
        color: #666;
    }

    .controller {
        display: flex;
        gap: 8px;
    }

    .spacer {
        flex-grow: 1;
    }
}
</style>

<% if flash[:message] %>
    <p><%= flash[:message] %></p>
<% end %>

<% if session[:user_id] %>
    <%= link_to 'ログアウト', signout_path %>
<% else %>
    <%= link_to 'ログイン', signin_path %>
    <%= link_to '新規登録', signup_path %>
<% end %>

<div class="main">
    <% if session[:user_id] %>
        <%= form_with url: tweet_path, method: :post do |form| %>
            <%= form.text_area :message, placeholder: "いまなにしてる？" %>
            <%= form.submit "ツイート" %>
        <% end %>
    <% end %>

    <% @tweets.each do |tweet| %>
        <div class="tweet">
            <div class="user">
                <div><%= tweet.user.uid %></div>
                <% if tweet.user.profile && tweet.user.profile.message %>
                    <div class="profile"><%= tweet.user.profile.message %></div>
                <% end %>
            </div>
            <div><%= tweet.message %></div>
            <div class="controller">
                <div><%= tweet.likes.count %>いいね</div>
                <% if session[:user_id] %>
                    <%= link_to 'いいね', like_tweet_path(tweet.id), data: { turbo_method: :post } %>
                    <%= link_to 'いいね解除', like_tweet_path(tweet.id), data: { turbo_method: :delete } %>
                    <div class="spacer"></div>
                    <% if tweet.user.id == session[:user_id] %>
                        <%= link_to '削除', delete_tweet_path(tweet.id), data: { turbo_method: :delete } %>
                    <% end %>
                <% end %>
            </div>
        </div>
    <% end %>
</div>